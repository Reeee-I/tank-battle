@echo off
chcp 936 >nul
title 双人坦克对战（玩家1=蓝牙）
cd /d "%~dp0"

echo ============================================================
echo   启动游戏（玩家1 = 蓝牙手柄）
echo   --------------------------------------------------------
echo   请先运行 启动BLE桥接.bat 并保持桥接窗口开着；
echo   若桥接还没就绪，游戏顶部玩家1 会先显示断开，
echo   桥接就绪后会自动连接恢复，无需重启游戏。
echo   玩家2：未插有线板 = 键盘（方向键+回车）
echo ============================================================

cd /d "%~dp002_上位机程序"
python main.py --p1 COM20

echo.
echo 游戏已退出。
pause
